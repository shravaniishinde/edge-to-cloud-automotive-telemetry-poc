# This file documents which environment variables the project expects.
# Copy it to `.env` and fill in real values — `.env` itself is gitignored
# and must never be committed.
#
# No variables are needed for local development by default. With none of
# the AWS_IOT_* variables below set, run_demo.py talks to local Mosquitto.
#
# If AWS IoT Core is configured, ALL required AWS_IOT_* variables must be
# provided. A partial AWS configuration is treated as an error rather than
# silently falling back to local Mosquitto.

# --- Phase 5: AWS IoT Core (optional -- only needed to run against AWS) ---

# AWS IoT Core device endpoint.
# Obtain this from Terraform output or AWS IoT Core.
# Example:
# AWS_IOT_ENDPOINT=a22nw24plfnt45-ats.iot.ap-south-1.amazonaws.com

# MQTT/TLS port used by AWS IoT Core.
# Defaults to 8883 if omitted.
# AWS_IOT_PORT=8883

# MQTT client ID.
# This must match the client identity allowed by the IoT policy.
# For the Terraform configuration in this project:
# AWS_IOT_CLIENT_ID=edge-to-cloud-telemetry-poc-vehicle

# Amazon Root CA certificate.
# This is a FILE PATH, not the certificate contents.
# AWS_IOT_CA_PATH=./infra/certs/AmazonRootCA1.pem

# Device X.509 certificate.
# This is a FILE PATH, not the certificate contents.
# AWS_IOT_CERT_PATH=./infra/certs/device-certificate.pem.crt

# Device private key.
# This is a FILE PATH, not the key contents.
# NEVER commit the actual private key.
# AWS_IOT_KEY_PATH=./infra/certs/device-private.pem.key