# This file documents which environment variables the project reads.
# Copy it to `.env` and fill in real values — `.env` itself is gitignored
# and must never be committed. Nothing in this project loads `.env`
# automatically: export the variables in the shell that runs the command
# (see docs/aws-setup.md for a PowerShell one-liner).
#
# No variables are needed for local development. With none of the
# AWS_IOT_* variables below set, run_demo.py talks to local Mosquitto.
#
# If AWS IoT Core is configured, ALL four required AWS_IOT_* variables
# (endpoint, CA, certificate, key) must be provided. A partial AWS
# configuration is treated as an error rather than silently falling back
# to local Mosquitto.

# --- AWS IoT Core (optional -- only needed to run against AWS) ---

# AWS IoT Core device data endpoint (required for AWS).
# Obtain it from `terraform output -raw aws_iot_endpoint` (in infra/) or
# AWS Console -> IoT Core -> Settings -> Device data endpoint.
# AWS_IOT_ENDPOINT=<your-endpoint-prefix>-ats.iot.ap-south-1.amazonaws.com

# MQTT client ID (REQUIRED in practice with this project's Terraform).
# The IoT policy in infra/iot.tf only allows iot:Connect for the client ID
# equal to the Thing name. If this is unset, the MQTT client uses a
# generated ID and AWS IoT Core rejects the connection.
# AWS_IOT_CLIENT_ID=edge-to-cloud-telemetry-poc-vehicle

# MQTT/TLS port used by AWS IoT Core. Defaults to 8883 if omitted.
# AWS_IOT_PORT=8883

# Amazon Root CA certificate (required for AWS).
# This is a FILE PATH, not the certificate contents.
# AWS_IOT_CA_PATH=./infra/certs/AmazonRootCA1.pem

# Device X.509 certificate (required for AWS).
# This is a FILE PATH, not the certificate contents.
# AWS_IOT_CERT_PATH=./infra/certs/device-certificate.pem.crt

# Device private key (required for AWS).
# This is a FILE PATH, not the key contents.
# NEVER commit the actual private key.
# AWS_IOT_KEY_PATH=./infra/certs/device-private.pem.key

# --- Optional advisory LLM explanations (analyzer/llm_explainer.py) ---
# Unset by default. Only used if code explicitly calls explain_anomaly();
# deterministic anomaly detection never needs it. Tests strip it.
# ANTHROPIC_API_KEY=<your-api-key>

# --- Optional local overrides ---
# Broker used by the dashboard and by the broker-backed tests (default localhost:1883).
# MQTT_BROKER_HOST=localhost
# MQTT_BROKER_PORT=1883
# Set to 1 to make broker-backed tests FAIL instead of skip when no broker is reachable (CI does).
# MQTT_BROKER_REQUIRED=1
# Engineering dashboard bind address (default 127.0.0.1:8080; keep it on localhost).
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8080
