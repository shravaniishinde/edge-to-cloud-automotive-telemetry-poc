# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Environment / secrets ---
# Real environment files must never be committed. Only .env.example is tracked.
.env
.env.*
!.env.example
*.pem
*.crt
*.key
*.p12
aws-credentials*

# --- Local data / buffers (created at runtime, not source) ---
*.sqlite3
*.db

# --- Docker ---
docker/volumes/

# --- Terraform (introduced Phase 5) ---
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# --- AWS IoT Core device credentials (Phase 5) ---
# terraform apply (see infra/) writes the generated device certificate,
# private key, and downloaded root CA here. *.pem/*.crt/*.key above
# already cover these files individually; this directory is called out
# explicitly too since it's where docs/aws-setup.md tells you to look.
infra/certs/

# --- Dashboard frontend (introduced Phase 10) ---
node_modules/
dist/
build/

# --- OS / editor ---
.DS_Store
.vscode/
.idea/
